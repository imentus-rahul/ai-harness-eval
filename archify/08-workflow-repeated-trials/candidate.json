    { "id": "tr", "lane": "pair", "col": 3, "type": "backend", "label": "transition()", "sublabel": "(PASS, FAIL)", "width": 160, "sources": [{ "path": "src/eval/compare.py", "line": 18, "end_line": 27 }] },
