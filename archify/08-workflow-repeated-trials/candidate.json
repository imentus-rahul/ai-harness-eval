    { "id": "b0", "lane": "base", "col": 0, "type": "backend", "label": "rep 0 · PASS", "sublabel": "pytest: 2 passed", "width": 160, "sources": [{ "path": "output/bad-harness-example/phase-1/baseline/trials/keep-suite/0/grade.json", "line": 1, "end_line": 5 }] },
    { "id": "b1", "lane": "base", "col": 1, "type": "backend", "label": "rep 1 · PASS", "sublabel": "pytest: 2 passed", "width": 160, "sources": [{ "path": "output/bad-harness-example/phase-1/baseline/trials/keep-suite/1/grade.json", "line": 1, "end_line": 5 }] },
    { "id": "bout", "lane": "base", "col": 2, "type": "backend", "label": "Baseline = PASS", "sublabel": "all([True, True])", "width": 160, "sources": [{ "path": "src/eval/compare.py", "line": 8, "end_line": 15 }] },

    { "id": "c0", "lane": "cand", "col": 0, "type": "security", "label": "rep 0 · FAIL", "sublabel": "assert 0 == 3", "width": 160, "sources": [{ "path": "output/bad-harness-example/phase-1/candidate/trials/keep-suite/0/grade.json", "line": 1, "end_line": 5 }] },
