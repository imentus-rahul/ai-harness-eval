    { "id": "unst", "lane": "edge", "col": 3, "type": "messagebus", "label": "UNSTABLE", "sublabel": "either arm mixed, e.g. [T, F]", "width": 160, "sources": [{ "path": "src/eval/compare.py", "line": 19, "end_line": 20 }] },
    { "id": "impr", "lane": "edge", "col": 4, "type": "backend", "label": "IMPROVED", "sublabel": "FAIL → PASS", "width": 160, "sources": [{ "path": "src/eval/compare.py", "line": 21, "end_line": 22 }] },
    { "id": "same", "lane": "edge", "col": 5, "type": "frontend", "label": "UNCHANGED", "sublabel": "same outcome both arms", "width": 160, "sources": [{ "path": "src/eval/compare.py", "line": 25, "end_line": 27 }] }
