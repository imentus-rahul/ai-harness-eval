  "edges": [
    { "from": "b0", "to": "b1", "role": "main" },
    { "from": "b1", "to": "bout", "role": "main" },
    { "from": "c0", "to": "c1", "role": "main", "variant": "security" },
    { "from": "c1", "to": "cout", "role": "main", "variant": "security" },
    { "from": "bout", "to": "tr", "role": "main" },
    { "from": "cout", "to": "tr", "role": "branch", "variant": "security" },
    { "from": "tr", "to": "res", "role": "main", "variant": "security" },
    { "from": "res", "to": "verdict", "role": "main", "variant": "security" },
    { "from": "tr", "to": "unst", "role": "branch", "variant": "dashed", "label": "checked first" }
  ],
  "cards": [
    { "dot": "cyan", "title": "outcome_from_reps(passes)", "items": ["[] → UNMEASURED", "all True → PASS", "all False → FAIL", "anything mixed → UNSTABLE"] },
    { "dot": "rose", "title": "transition(baseline, candidate) — in order", "items": ["either UNSTABLE → UNSTABLE", "FAIL → PASS → IMPROVED", "PASS → FAIL → REGRESSED", "equal → UNCHANGED, otherwise MIXED (e.g. UNMEASURED)"] },
    { "dot": "amber", "title": "Why repetitions matter", "items": ["LLM output is stochastic (temperature 0.2): one run can be luck", "UNSTABLE is never rounded into IMPROVED or REGRESSED", "n = 2 detects flakiness but is NOT statistical significance"] },
    { "dot": "violet", "title": "summarise() verdict", "items": ["any REGRESSED → NEGATIVE", "else any IMPROVED → POSITIVE", "else INCONCLUSIVE"] }
  ]
