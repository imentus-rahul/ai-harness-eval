 "cards": [
  {
   "dot": "cyan",
   "title": "Who writes what",
   "items": [
    "trial.py write_trial_artifacts \u2192 transcript, grade, cost/usage, tools/trace, errors/execution.log, result/findings.json",
    "report.py \u2192 <arm>/README.md, comparison/README.md + result.json, human_spot_check.md",
    "run.py \u2192 phase summary.json, <example>/summary.json, output/summary.json"
   ]
  },
  {
   "dot": "emerald",
   "title": "What each artifact answers",
   "items": [
    "transcript.json \u2014 what the agent said and which tools it called",
    "grade.json \u2014 why it passed or failed (code_reason) and model disagreement",
    "cost/usage.json \u2014 tokens, cost_usd, cost_source (reported|computed|mock), latency, TTFT",
    "comparison/result.json \u2014 per-task transition between arms"
   ]
  },
  {
   "dot": "amber",
   "title": "Lifecycle notes",
   "items": [
    "output/<example>/ is deleted and rebuilt on every run",
    "_workspaces/ keep the post-agent repo for inspection (keep-suite overlay visible there)",
    "errors/execution.log contains 'none' when no errors",
    "human_spot_check.md is written per scenario by write_human_spot_check() (points at candidate findings)"
   ]
  }
 ]
