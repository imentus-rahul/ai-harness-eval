  {
   "dot": "cyan",
   "title": "Model \u00b7 Agent \u00b7 Harness",
   "items": [
    "Model \u2014 the LLM behind OpenRouter (anthropic/claude-haiku-4.5 default)",
    "Agent \u2014 model + execution loop + tools acting on a workspace (run_agent)",
    "Harness \u2014 everything around the model: guidance, tools, loop, budgets",
    "Model \u2260 Agent \u2260 Harness: this repo changes ONLY the harness guidance"
   ]
  },
  {
   "dot": "violet",
   "title": "Prompts + guidance",
   "items": [
    "Prompt \u2014 the task instruction, tasks/<id>/prompt.txt (user message)",
    "System prompt \u2014 guidance text + 'You must use tools\u2026 write findings.json'",
    "AGENTS.md \u2014 repo-level baseline instructions (harnesses/baseline/)",
    "SKILL.md \u2014 a focused capability skill (good-candidate / bad-candidate)"
   ]
  },
  {
   "dot": "amber",
   "title": "Tools + context",
   "items": [
    "Tools \u2014 read_file, list_files, write_file; paths cannot escape the workspace",
    "MCP / external context \u2014 NOT implemented here (no MCP servers, no web)",
    "Context the agent gets = system prompt + task prompt + files it reads"
   ]
  },
  {
   "dot": "emerald",
   "title": "Evaluation vocabulary",
   "items": [
    "Task \u2014 prompt + repo + held-out success criteria",
    "Trial \u2014 one arm on one task in an isolated workspace",
    "Repetition \u2014 REPS = 2 trials per task per arm",
    "Grader \u2014 code (authoritative) or model rubric (evidence)",
    "Baseline / Candidate \u2014 the two arms compared on identical tasks"
   ]
  },
  {
   "dot": "rose",
   "title": "Suites, graduation, phases",
   "items": [
    "Capability suite \u2014 what the candidate is learning (auth-vs-log, caller-check)",
    "Regression suite \u2014 must keep passing (keep-suite)",
    "Graduation \u2014 capability task passed every candidate rep \u2192 becomes regression",
    "Phase \u2014 one full baseline-vs-candidate pass; Phase 2 runs only if the gate allows",
    "Evaluation harness \u2014 this repo: runs trials, grades, compares, gates"
   ]
  }
 ]
